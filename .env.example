# Optional. Leave unset for local development at http://localhost:3000.
# Set to /42 before the production build that is served at https://curitopia.com/42.
NEXT_PUBLIC_BASE_PATH=

# Public project URL and publishable key used by a production build and the Linode deployment.
# Use https://YOUR_PROJECT.supabase.co. A copied REST address ending in /rest/v1 is accepted.
# Do not put a service-role key in this file or in client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local `next dev` only. These replace the two variables above while developing.
# A missing or malformed pair stops the local app. It does not fall back to the production project.
# Do not put a service-role key here.
NEXT_PUBLIC_SUPABASE_DEV_URL=
NEXT_PUBLIC_SUPABASE_DEV_PUBLISHABLE_KEY=

# Server-only image and question help. Never expose these to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=
