# Optional. Leave unset for local development at http://localhost:3000.
# Set to /42 before the production build that is served at https://curitopia.com/42.
NEXT_PUBLIC_BASE_PATH=

# Public project URL and publishable key used by a production build and the Linode deployment.
# Use https://YOUR_PROJECT.supabase.co. A copied REST address ending in /rest/v1 is accepted.
# Do not put a service-role key in this file or in client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local `next dev` only. These replace the two variables above while developing.
# A missing or malformed pair stops the local app. It does not fall back to the production project.
# Do not put a service-role key here.
NEXT_PUBLIC_SUPABASE_DEV_URL=
NEXT_PUBLIC_SUPABASE_DEV_PUBLISHABLE_KEY=

# Server-only key that signs an Experience visualisation snapshot.
# At least 32 characters. Use the same value on every application instance.
# The server refuses to open Visualise when this is missing or shorter.
# It is not a NEXT_PUBLIC variable and must not be committed with a real value.
VISUALISATION_SNAPSHOT_SECRET=

# Server-only image and question help. Never expose these to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=

# Production Experience stays closed unless both values are the exact word allow.
# NEXT_PUBLIC_EXPERIENCE_PRODUCTION_UI is inlined into the browser bundle by next build.
# Set it in the build environment before building. Setting it only before next start
# leaves the shipped UI closed. EXPERIENCE_PRODUCTION_API is read on the server and
# is not a public variable. Leave both unset until a release deliberately opens Experience.
# Local next dev ignores both, including when they are set to allow.
NEXT_PUBLIC_EXPERIENCE_PRODUCTION_UI=
EXPERIENCE_PRODUCTION_API=
