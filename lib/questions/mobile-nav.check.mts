import assert from 'node:assert/strict'
import { readFileSync } from 'node:fs'
import { branchContextNotice, branchMigrationNotice, noticeWithoutBranchContext } from './branch-notice.ts'

assert.equal(branchContextNotice(null), null)
assert.equal(branchContextNotice('The concepts could not be loaded.'), null)
assert.equal(branchContextNotice(branchMigrationNotice), branchMigrationNotice)
assert.equal(noticeWithoutBranchContext(null), null)
assert.equal(noticeWithoutBranchContext(branchMigrationNotice), null)
assert.equal(noticeWithoutBranchContext(`${branchMigrationNotice} The concepts could not be loaded.`), 'The concepts could not be loaded.')

const app = readFileSync(new URL('../../components/studio/curitopia-app.tsx', import.meta.url), 'utf8')
const gather = readFileSync(new URL('../../components/studio/gather-stage.tsx', import.meta.url), 'utf8')
const visualise = readFileSync(new URL('../../components/studio/visualise-stage.tsx', import.meta.url), 'utf8')
const library = readFileSync(new URL('../../components/studio/library-view.tsx', import.meta.url), 'utf8')
const comparison = readFileSync(new URL('../../components/studio/concept-comparison.tsx', import.meta.url), 'utf8')
const shell = readFileSync(new URL('../../components/studio/studio-shell.tsx', import.meta.url), 'utf8')

assert.equal(app.includes('noticeWithoutBranchContext'), true)
assert.equal(app.includes('branchContextNotice'), true)
assert.equal(app.includes('branchNotice={branchNotice}'), true)
assert.equal(app.includes("stage !== 'gather'"), false)
assert.equal(gather.includes('branchNotice'), true)
assert.equal(gather.includes('Create a branch'), true)
assert.equal(gather.includes('>Park<'), true)
assert.equal(gather.includes('>Discard<'), true)
assert.equal(gather.includes('Restore as its own question'), true)
assert.equal(app.includes('CurateStage'), false)
assert.equal(app.includes('DistilStage'), false)
assert.equal(visualise.includes('branchMigrationNotice'), false)
assert.equal(visualise.includes('branchNotice'), false)
assert.equal(library.includes(branchMigrationNotice), false)
assert.equal(comparison.includes(branchMigrationNotice), false)
assert.equal(shell.includes('lg:hidden'), true)
assert.equal(shell.includes('lg:flex'), true)
assert.equal(/className="hidden [^"]*lg:flex/.test(shell), true)
assert.equal(shell.includes('aria-expanded'), true)
assert.equal(shell.includes('Open sections'), true)
assert.equal(shell.includes("label: 'Garden'"), true)
assert.equal(shell.includes("label: 'Visualise'"), true)
assert.equal(shell.includes("label: 'Library of Curiosities'"), true)
assert.equal(shell.includes("label: 'Curate'"), false)
assert.equal(shell.includes("label: 'Distil'"), false)
assert.equal(shell.includes("label: 'Gather'"), false)
const openAt = shell.indexOf('function openSection')
const openSection = shell.slice(openAt, shell.indexOf('return (', openAt))
assert.equal(openSection.indexOf('onStage') < openSection.indexOf('setMenuOpen(false)'), true)
assert.equal(library.includes('Library scope'), true)
assert.equal(library.includes('Current curiosity'), false)
assert.equal(comparison.includes('grid-cols-2'), true)

const banner = readFileSync(new URL('../../components/site-banner.tsx', import.meta.url), 'utf8')
const theme = readFileSync(new URL('../../app/globals.css', import.meta.url), 'utf8')
const home = readFileSync(new URL('../../components/studio/curiosity-landing.tsx', import.meta.url), 'utf8')
const accountLibrary = readFileSync(new URL('../../components/studio/account-library.tsx', import.meta.url), 'utf8')
const consultancy = readFileSync(new URL('../../components/consultancy/landing.tsx', import.meta.url), 'utf8')
assert.equal(theme.includes('--color-logo-orange: #ff7f50'), true)
assert.equal(banner.includes('bg-logo-orange'), true)
assert.equal(banner.includes('/header.png'), true)
assert.equal(banner.includes('Sign out'), true)
assert.equal(shell.includes('BrandBanner'), true)
assert.equal(home.includes('BrandBanner'), true)
assert.equal(accountLibrary.includes('BrandBanner'), true)
assert.equal(consultancy.includes('<SiteBanner'), true)
assert.equal(consultancy.includes('BrandBanner'), false)

console.log('mobile navigation checks passed')
